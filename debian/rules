#!/usr/bin/make -f

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
	-DMINKIDLC_BIN_DIR=/usr/lib/$(DEB_HOST_MULTIARCH)/mink/bin \
	-DSYSTEMD_UNIT_DIR=/usr/lib/systemd/system \
	-DUDEV_DIR=/etc/udev/rules.d \
	-DBUILD_PKCS11=OFF \
	-DBUILD_RPMB_LISTENER=OFF

override_dh_installsystemd:
	dh_installsystemd --name=qteesupplicant
	dh_installsystemd --name=sfsonfig
